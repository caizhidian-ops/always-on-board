{
  "name": "@local/dsh-ops-board",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Always-on Board: local background-task visibility and Agent intervention for AI coders using DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "processes.js",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check processes.js && node --check client.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caizhidian-ops/always-on-board.git"
  }
}
